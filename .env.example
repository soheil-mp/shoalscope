# Copy to .env and fill in. Never commit .env.
# Every variable the code reads is listed here with a placeholder value.
# Public data sources (NOAA water column sonar archive, OOI raw data archive, OOI ERDDAP)
# need no credentials.

# --- Data budget (fail closed when exceeded) --------------------------------
SHOALSCOPE_PROFILE=dev                     # dev | demo | ci
SHOALSCOPE_STORAGE_BUDGET_MIB=512          # total bytes the local lakehouse may hold
SHOALSCOPE_FETCH_BUDGET_MIB_PER_DAY=256    # transient bytes fetched from sources per day
SHOALSCOPE_CACHE_DIR=./cache               # raw-window cache, size-capped and evicted

# --- Sources -------------------------------------------------------------------
SHOALSCOPE_NOAA_WCSD_BUCKET=noaa-wcsd-pds
SHOALSCOPE_NOAA_WCSD_ZARR_BUCKET=noaa-wcsd-zarr-pds
SHOALSCOPE_OOI_RAW_BASE_URL=https://rawdata.oceanobservatories.org/files
SHOALSCOPE_OOI_ERDDAP_URL=https://erddap.dataexplorer.oceanobservatories.org/erddap
SHOALSCOPE_HTTP_USER_AGENT=shoalscope/0.0 (+https://github.com/your-github-user/shoalscope)

# --- Local object storage (SeaweedFS S3 gateway) --------------------------------
SHOALSCOPE_S3_ENDPOINT=http://localhost:8333
SHOALSCOPE_S3_REGION=us-east-1
SHOALSCOPE_S3_ACCESS_KEY_ID=your-access-key-id
SHOALSCOPE_S3_SECRET_ACCESS_KEY=your-secret-access-key
SHOALSCOPE_S3_BUCKET=shoalscope

# --- Iceberg REST catalog (Lakekeeper) and its database -----------------------
SHOALSCOPE_ICEBERG_CATALOG_URI=http://localhost:8181/catalog
SHOALSCOPE_ICEBERG_WAREHOUSE=shoalscope
LAKEKEEPER_PG_PASSWORD=change-me
LAKEKEEPER_ENCRYPTION_KEY=change-me-32-characters-minimum

# --- Icechunk repositories (arrays) -------------------------------------------
SHOALSCOPE_ICECHUNK_PREFIX=icechunk

# --- Edge transport (NATS JetStream) -------------------------------------------
SHOALSCOPE_NATS_URL=nats://localhost:4222
SHOALSCOPE_NATS_CREDS_FILE=./deploy/local/nats/edge.creds
SHOALSCOPE_EDGE_TELEMETRY_BUDGET_BYTES_PER_HOUR=200000

# --- Orchestration --------------------------------------------------------------
DAGSTER_HOME=./.dagster
DAGSTER_PG_PASSWORD=change-me

# --- Observability --------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=shoalscope
